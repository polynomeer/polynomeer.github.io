---
layout: compress
swcache: true
---

{%- comment -%}
  Titles, tags and categories only: the slice of the index that makes search
  usable immediately. `search.json` carries the same entries plus the post
  text and is fetched right after this one, so keep the selection rule below
  identical to the one there.
{%- endcomment -%}

{% assign search_cutoff_ts = site.time | date: '%s' | plus: 0 | minus: 63072000 %}
{% assign search_first_item = true %}

[
  {% for post in site.posts %}
  {% assign post_ts = post.date | date: '%s' | plus: 0 %}
  {% assign include_in_search = false %}
  {% if post.path contains '/notes/' or post.pin == true or post_ts >= search_cutoff_ts %}
    {% assign include_in_search = true %}
  {% endif %}
  {% if include_in_search %}
  {% unless search_first_item %},{% endunless %}
  {% assign search_first_item = false %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ post.categories | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date_label": {{ post.date | date: site.data.locales[site.lang].df.post.strftime | jsonify }},
    "series": {{ post.series | jsonify }},
    "series_title": {{ post.series_title | jsonify }},
    "content": ""
  }
  {% endif %}
  {% endfor %}
]
