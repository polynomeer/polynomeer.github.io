---
layout: compress
swcache: true
---

{% include lang.html %}
{% assign home_feed_excluded_segment = '/problemsolving/' %}
{% assign home_feed_cutoff_ts = site.time | date: '%s' | plus: 0 | minus: 63072000 %}
{% assign ordered_entries = '' | split: '' %}

{% for post in site.posts %}
  {% unless post.path contains home_feed_excluded_segment %}
    {% if post.hidden != true %}
      {% capture ordered_entry %}{{ post.date | date: '%Y%m%d%H%M%S' }}::{{ forloop.index0 }}{% endcapture %}
      {% assign ordered_entries = ordered_entries | push: ordered_entry %}
    {% endif %}
  {% endunless %}
{% endfor %}

{% assign ordered_entries = ordered_entries | sort | reverse %}
{% assign ordered_posts = '' | split: '' %}

{% for entry in ordered_entries %}
  {% assign index = entry | split: '::' | last | plus: 0 %}
  {% assign ordered_posts = ordered_posts | push: site.posts[index] %}
{% endfor %}

{% assign feed_posts = '' | split: '' %}
{% for post in ordered_posts %}
  {% assign feed_posts = feed_posts | push: post %}
{% endfor %}

[
  {% assign home_feed_first_item = true %}
  {% for post in feed_posts %}
    {% assign post_ts = post.date | date: '%s' | plus: 0 %}
    {% assign include_in_home_feed_data = false %}
    {% if post.path contains '/notes/' or post.pin == true or post_ts >= home_feed_cutoff_ts %}
      {% assign include_in_home_feed_data = true %}
    {% endif %}
    {% if include_in_home_feed_data %}
      {% unless home_feed_first_item %},{% endunless %}
      {% assign home_feed_first_item = false %}
    {% capture post_content_type_id %}{% include content-type-id.html post=post %}{% endcapture %}
    {% assign post_content_type_id = post_content_type_id | strip %}
    {% assign content_type = site.data.content_types[post_content_type_id] %}
    {% capture summary %}{% include post-description.html %}{% endcapture %}
    {% assign summary = summary | strip | strip_newlines %}
    {% assign src = nil %}
    {% assign alt = nil %}
    {% if post.image %}
      {% assign src = post.image.path | default: post.image %}
      {% unless src contains '//' %}
        {% assign src = post.media_subpath | append: '/' | append: src | replace: '//', '/' %}
      {% endunless %}
      {% assign alt = post.image.alt | default: 'Preview Image' %}
    {% endif %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "typeId": {{ post_content_type_id | jsonify }},
      "typeLabel": {{ content_type.title.en | default: content_type.title['ko-KR'] | default: content_type.title | default: post_content_type_id | jsonify }},
      "typeIcon": {{ content_type.icon | jsonify }},
      "typeUrl": {{ '/types/' | append: post_content_type_id | append: '/' | relative_url | jsonify }},
      "summary": {{ summary | jsonify }},
      "dateLabel": {{ post.date | date: site.data.locales[lang].df.post.strftime | jsonify }},
      "categories": {{ post.categories | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "imageSrc": {{ src | jsonify }},
      "imageAlt": {{ alt | jsonify }},
      "pin": {{ post.pin | default: false | jsonify }}
    }
    {% endif %}
  {% endfor %}
]
